# Console configuration. Copy to .env and adjust.
#
# Only variables prefixed with VITE_ reach the browser, and everything here is
# embedded in the built bundle at compile time — so treat every value as
# public. Never put a secret in this file.

# Where the console sends API requests.
#
# Leave as /api to use the dev server's proxy (see VITE_API_PROXY_TARGET), so
# the browser sees a single origin and no CORS configuration is needed. Set an
# absolute URL when the console is served from a different origin than the API,
# for example https://api.mbillspays.example/api.
VITE_API_BASE_URL=/api

# Development only: where the dev server forwards /api requests. Ignored in a
# production build.
VITE_API_PROXY_TARGET=http://localhost:8000

# Shown in the console sidebar so an operator can always tell which
# environment they are working in. Use: local, sandbox, or production.
VITE_ENVIRONMENT=local
